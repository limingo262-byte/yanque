# 百炼 API Key（必填），控制台 https://bailian.console.aliyun.com 获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型 ID：通义千问 3.7 Plus
# 以百炼控制台「模型广场」显示的 ID 为准，不一致时改这里即可
BAILIAN_MODEL=qwen3.7-plus

# 接入地址，二选一：
# 1) 公共入口（默认，不填就用这个）
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 2) 业务空间专属域名：只填 WorkspaceId，程序自动拼北京地域域名
# BAILIAN_WORKSPACE_ID=llm-xxxxxxxx

# 生成参数
BAILIAN_TEMPERATURE=0.7
# BAILIAN_MAX_TOKENS=2000

# 超时与重试（重试放在 Python 这一层，Java 侧不重试）
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=2

# 上下文兜底截断：最多带多少条历史原文
BAILIAN_MAX_HISTORY_MESSAGES=20

# Java 管理端地址：Python 运行时通过 /internal/ai/prompts/active 读取提示词
YANQUE_ADMIN_BASE_URL=http://localhost:8080
PROMPT_QUERY_TIMEOUT_SECONDS=5

# Text-to-SQL 意图识别系统提示词编码，对应管理平台当前启用提示词
TEXT_TO_SQL_INTENT_PROMPT_CODE=text_to_sql_intent_system

# Text-to-SQL 指标知识库 Collection，指标检索固定使用 HYBRID 混合检索
TEXT_TO_SQL_METRIC_COLLECTION=text_to_sql_metrics
TEXT_TO_SQL_METRIC_TOP_K=5
TEXT_TO_SQL_METRIC_RECALL_TOP_K=20

# Text-to-SQL 检索重排：先多召回，再用 rerank 分数过滤低相关结果
TEXT_TO_SQL_RERANK_ENABLED=true
TEXT_TO_SQL_RERANK_MIN_SCORE=0.6

# Bear MCP 中台地址：业务说明、查询注意事项等固定资料从 MCP Resource 读取
BEAR_MCP_URL=http://localhost:8090/mcp
BEAR_MCP_TOKEN=mcp_dev_token

# Milvus 练习脚本 test/milvus_crud_demo.py
MILVUS_URI=http://124.223.194.220:19530
MILVUS_DB_NAME=default
MILVUS_DENSE_VECTOR_DIM=1024
MILVUS_DENSE_METRIC_TYPE=COSINE
MILVUS_SPARSE_METRIC_TYPE=BM25
# MILVUS_TOKEN=

# 知识库管理服务直接使用知识库 code 作为 Collection 名称
# 每个 Collection 都包含 dense_vector 稠密向量字段和 sparse_vector BM25 稀疏向量字段
MILVUS_COLLECTION=course_knowledge_crud_demo
# 稀疏向量 + 混合检索练习脚本 test/milvus_sparse_hybrid_demo.py
MILVUS_SPARSE_HYBRID_COLLECTION=course_knowledge_sparse_hybrid_demo
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
# 百炼 Embedding 接口单次最多 20 条，LlamaIndex 默认 100，需要显式压低
BAILIAN_EMBEDDING_BATCH_SIZE=20

# LlamaIndex 核心流程练习脚本 test/llamaindex_core_demo.py
LLAMAINDEX_DEMO_MILVUS_COLLECTION=course_knowledge_llamaindex_demo
LLAMAINDEX_DEMO_MILVUS_METRIC_TYPE=COSINE
LLAMAINDEX_DEMO_CHUNK_SIZE=120
LLAMAINDEX_DEMO_CHUNK_OVERLAP=20
LLAMAINDEX_DEMO_TOP_K=3
