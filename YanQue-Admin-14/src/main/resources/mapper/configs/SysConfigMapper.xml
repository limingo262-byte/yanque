<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.modules.configs.mapper.SysConfigMapper">
    <resultMap id="ConfigMap" type="cn.yanque.modules.configs.pojo.entity.SysConfigEntity">
        <id property="id" column="id"/>
        <result property="k" column="k"/>
        <result property="v" column="v"/>
    </resultMap>

    <select id="selectPage" resultMap="ConfigMap">
        select id, k, v from sys_config
        <where>
            <if test="keyword != null and keyword != ''">
                and (k like concat('%', #{keyword}, '%')
                or v like concat('%', #{keyword}, '%'))
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultMap="ConfigMap">
        select id, k, v from sys_config where id = #{id}
    </select>

    <select id="selectByKey" resultMap="ConfigMap">
        select id, k, v from sys_config where k = #{key}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into sys_config(k, v) values(#{k}, #{v})
    </insert>

    <update id="updateById">
        update sys_config set k = #{k}, v = #{v} where id = #{id}
    </update>

    <delete id="deleteById">delete from sys_config where id = #{id}</delete>
</mapper>
