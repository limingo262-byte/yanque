<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.modules.config.mapper.SysConfigMapper">

    <resultMap id="SysConfigMap" type="cn.yanque.modules.config.pojo.entity.SysConfigEntity">
        <id property="id" column="id"/>
        <result property="k" column="k"/>
        <result property="v" column="v"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, k, v, created_at, updated_at
    </sql>

    <select id="selectById" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/> from sys_config where id = #{id}
    </select>

    <select id="selectByKey" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/> from sys_config where k = #{k}
    </select>

    <select id="selectPage" resultMap="SysConfigMap">
        select <include refid="BaseColumns"/> from sys_config
        <where>
            <if test="keyword != null and keyword != ''">
                and (
                    k like concat('%', #{keyword}, '%')
                    or v like concat('%', #{keyword}, '%')
                )
            </if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="cn.yanque.modules.config.pojo.entity.SysConfigEntity"
            useGeneratedKeys="true" keyProperty="id">
        insert into sys_config (k, v, created_at, updated_at)
        values (#{k}, #{v}, now(), now())
    </insert>

    <update id="updateById" parameterType="cn.yanque.modules.config.pojo.entity.SysConfigEntity">
        update sys_config
        set k = #{k},
            v = #{v},
            updated_at = now()
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from sys_config where id = #{id}
    </delete>
</mapper>