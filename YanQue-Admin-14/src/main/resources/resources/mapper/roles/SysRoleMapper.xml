<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.yanque.modules.roles.mapper.SysRoleMapper">

    <resultMap id="SysRoleMap" type="cn.yanque.modules.roles.pojo.entity.SysRoleEntity">
        <id property="id" column="id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id, role_code, role_name, description, status, created_at, updated_at
    </sql>

    <select id="selectById" resultMap="SysRoleMap">
        select <include refid="BaseColumns"/> from sys_role where id = #{id}
    </select>

    <select id="selectByRoleCode" resultMap="SysRoleMap">
        select <include refid="BaseColumns"/> from sys_role where role_code = #{roleCode}
    </select>

    <select id="selectPage" resultMap="SysRoleMap">
        select <include refid="BaseColumns"/> from sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                and (
                    role_code like concat('%', #{keyword}, '%')
                    or role_name like concat('%', #{keyword}, '%')
                )
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectByIds" resultMap="SysRoleMap">
        select <include refid="BaseColumns"/> from sys_role
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectByUserId" resultMap="SysRoleMap">
        select r.id, r.role_code, r.role_name, r.description, r.status, r.created_at, r.updated_at
        from sys_role r
        inner join sys_user_role ur on ur.role_id = r.id
        where ur.user_id = #{userId}
        order by r.id asc
    </select>

    <insert id="insert" parameterType="cn.yanque.modules.roles.pojo.entity.SysRoleEntity"
            useGeneratedKeys="true" keyProperty="id">
        insert into sys_role
        (role_code, role_name, description, status, created_at, updated_at)
        values
        (#{roleCode}, #{roleName}, #{description}, #{status}, now(), now())
    </insert>

    <update id="updateById" parameterType="cn.yanque.modules.roles.pojo.entity.SysRoleEntity">
        update sys_role
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = now()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from sys_role where id = #{id}
    </delete>
</mapper>
