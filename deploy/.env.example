MYSQL_ROOT_PASSWORD=change-this
REDIS_PASSWORD=change-this
DASHSCOPE_API_KEY=sk-your-key
BAILIAN_MODEL=qwen3.7-plus
BEAR_MCP_TOKEN=change-this
BEAR_ADMIN_JWT_SECRET=change-this-long-random-secret
YANQUE_INTERNAL_TOKEN=change-this-internal-service-token
MILVUS_URI=http://host.docker.internal:19530
IMAGE_TAG=local

# Alibaba Cloud SLS; keep real values only in /opt/yanque/.env on the server.
SLS_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SLS_ENDPOINT=cn-hangzhou-intranet.log.aliyuncs.com
SLS_PROJECT=
SLS_LOGSTORE=
SLS_MAX_RANGE_HOURS=24
SLS_MAX_ROWS=500

# 飞书业务分析任务网关与本地 Codex Agent
ANALYSIS_GATEWAY_TOKEN=replace-with-random-gateway-token
# ngrok 为本地 8787 端口生成的 HTTPS 地址
AGENT_NODE_URL=https://replace-me.ngrok-free.app
# 服务器与本地 Agent 必须使用同一个随机 Token
AGENT_NODE_TOKEN=replace-with-random-agent-token
AGENT_NODE_POLL_SECONDS=2
AGENT_NODE_TIMEOUT_SECONDS=240
